{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "chomiamos-dashboard",
  "version": "0.5.2",
  "identifier": "org.chomiamos.dashboard",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ChomiamOS Dashboard",
        "width": 1380,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "label": "main",
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": null
    }
  }
}