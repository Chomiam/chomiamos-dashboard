import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DashboardBridge, GenerationItem } from "bridge.slint";
export { DashboardBridge, GenerationItem }
import { Card, ProgressBar, ToggleSwitch, ActionBtn, NavItem } from "components.slint";

export component AppWindow inherits Window {
    title: "ChomiamOS Dashboard";
    icon: @image-url("../frontend/assets/logo.png");
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 950px;
    min-height: 650px;
    background: Theme.base;

    HorizontalLayout {
        // === SIDEBAR ===
        Rectangle {
            width: 230px;
            background: Theme.crust;

            VerticalLayout {
                padding: 18px;
                spacing: 16px;

                // Logo + Title
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Image {
                        source: @image-url("../frontend/assets/logo.png");
                        width: 38px;
                        height: 38px;
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "ChomiamOS";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Gaming Edition";
                            color: Theme.mauve;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.surface0;
                }

                // Navigation Items
                NavItem {
                    icon: "🖥️";
                    text: "Vue Système";
                    active: DashboardBridge.active_tab == 0;
                    clicked => { DashboardBridge.active_tab = 0; }
                }

                NavItem {
                    icon: "💽";
                    text: "Disques & Générations";
                    active: DashboardBridge.active_tab == 1;
                    clicked => { DashboardBridge.active_tab = 1; }
                }

                NavItem {
                    icon: "⚙️";
                    text: "Configuration & Apps";
                    active: DashboardBridge.active_tab == 2;
                    clicked => { DashboardBridge.active_tab = 2; }
                }

                // Spacer
                Rectangle { }

                // Bottom System Pill
                Card {
                    background: Theme.mantle;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.green;
                                y: 3px;
                            }
                            Text {
                                text: DashboardBridge.hostname;
                                color: Theme.text;
                                font-size: 12px;
                                font-weight: 600;
                            }
                        }

                        Text {
                            text: DashboardBridge.kernel_version;
                            color: Theme.subtext0;
                            font-size: 11px;
                        }

                        Text {
                            text: "Uptime: " + DashboardBridge.uptime;
                            color: Theme.overlay0;
                            font-size: 10px;
                        }
                    }
                }
            }
        }

        // === MAIN CONTENT AREA ===
        Rectangle {
            background: Theme.base;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Tab 0: SYSTEM TELEMETRY
                if DashboardBridge.active_tab == 0: VerticalLayout {
                    spacing: 14px;

                    // Top Row: CPU & GPU
                    HorizontalLayout {
                        spacing: 14px;

                        // CPU Card
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "PROCESSEUR (CPU)";
                                        color: Theme.mauve;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: DashboardBridge.cpu_freq;
                                        color: Theme.peach;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                }

                                Text {
                                    text: DashboardBridge.cpu_model;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Utilisation globale";
                                        color: Theme.subtext0;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: Math.round(DashboardBridge.cpu_usage) + " %";
                                        color: Theme.mauve;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }
                                }

                                ProgressBar {
                                    progress: DashboardBridge.cpu_usage;
                                    fill-color: Theme.mauve;
                                    bar-height: 8px;
                                }

                                Rectangle { height: 4px; }

                                // 16-Core Mini Activity Visualizer
                                Text {
                                    text: "Activité des 16 cœurs logiques :";
                                    color: Theme.overlay0;
                                    font-size: 11px;
                                }

                                GridLayout {
                                    spacing: 6px;
                                    for core[idx] in DashboardBridge.cpu_cores: Rectangle {
                                        col: Math.mod(idx, 8);
                                        row: Math.floor(idx / 8);
                                        height: 24px;
                                        background: Theme.surface0;
                                        border-radius: 4px;

                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            width: parent.width * (Math.clamp(core, 0.0, 100.0) / 100.0);
                                            height: parent.height;
                                            background: core > 80.0 ? Theme.red : (core > 50.0 ? Theme.peach : Theme.blue);
                                            border-radius: parent.border-radius;
                                        }

                                        Text {
                                            text: "C" + idx;
                                            color: Theme.text;
                                            font-size: 10px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // GPU Card
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "CARTE GRAPHIQUE (GPU)";
                                        color: Theme.blue;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: Math.round(DashboardBridge.gpu_temp) + " °C";
                                        color: DashboardBridge.gpu_temp > 75.0 ? Theme.red : Theme.green;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                Text {
                                    text: DashboardBridge.gpu_name;
                                    color: Theme.text;
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Charge GPU (" + DashboardBridge.gpu_driver + ")";
                                        color: Theme.subtext0;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: Math.round(DashboardBridge.gpu_usage) + " %";
                                        color: Theme.blue;
                                        font-size: 15px;
                                        font-weight: 700;
                                    }
                                }

                                ProgressBar {
                                    progress: DashboardBridge.gpu_usage;
                                    fill-color: Theme.blue;
                                    bar-height: 8px;
                                }

                                Rectangle { height: 6px; }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Mémoire Vidéo (VRAM)";
                                        color: Theme.subtext0;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: DashboardBridge.vram_used + " / " + DashboardBridge.vram_total + " (" + Math.round(DashboardBridge.vram_percent) + " %)";
                                        color: Theme.sapphire;
                                        font-size: 12px;
                                        font-weight: 600;
                                    }
                                }

                                ProgressBar {
                                    progress: DashboardBridge.vram_percent;
                                    fill-color: Theme.sapphire;
                                    bar-height: 8px;
                                }
                            }
                        }
                    }

                    // Middle Row: RAM, Swap & Storage
                    HorizontalLayout {
                        spacing: 14px;

                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "MÉMOIRE VIVE & SWAP";
                                    color: Theme.green;
                                    font-size: 12px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "RAM : " + DashboardBridge.ram_used + " / " + DashboardBridge.ram_total;
                                        color: Theme.text;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: Math.round(DashboardBridge.ram_percent) + " %";
                                        color: Theme.green;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                ProgressBar {
                                    progress: DashboardBridge.ram_percent;
                                    fill-color: Theme.green;
                                    bar-height: 7px;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "SWAP : " + DashboardBridge.swap_used + " / " + DashboardBridge.swap_total;
                                        color: Theme.subtext0;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: Math.round(DashboardBridge.swap_percent) + " %";
                                        color: Theme.teal;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                ProgressBar {
                                    progress: DashboardBridge.swap_percent;
                                    fill-color: Theme.teal;
                                    bar-height: 7px;
                                }
                            }
                        }

                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;

                                Text {
                                    text: "STOCKAGE DISQUES";
                                    color: Theme.peach;
                                    font-size: 12px;
                                    font-weight: 700;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Système (/) : " + DashboardBridge.disk_root_used + " / " + DashboardBridge.disk_root_total;
                                        color: Theme.text;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: Math.round(DashboardBridge.disk_root_percent) + " %";
                                        color: Theme.peach;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                ProgressBar {
                                    progress: DashboardBridge.disk_root_percent;
                                    fill-color: Theme.peach;
                                    bar-height: 7px;
                                }

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Jeux (/mnt/Games) : " + DashboardBridge.disk_games_used + " / " + DashboardBridge.disk_games_total;
                                        color: Theme.subtext0;
                                        font-size: 12px;
                                    }
                                    Text {
                                        text: Math.round(DashboardBridge.disk_games_percent) + " %";
                                        color: Theme.flamingo;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }

                                ProgressBar {
                                    progress: DashboardBridge.disk_games_percent;
                                    fill-color: Theme.flamingo;
                                    bar-height: 7px;
                                }
                            }
                        }
                    }

                    // Bottom Row: Updates Banner
                    Card {
                        background: Theme.crust;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: space-between;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: "🚀 MISES À JOUR DU SYSTÈME";
                                        color: Theme.mauve;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                }
                                Text {
                                    text: "Dépôts Nix Flake & Zen Kernel";
                                    color: Theme.subtext0;
                                    font-size: 12px;
                                }
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                ActionBtn {
                                    text: "⚡ Mettre à jour maintenant (nh os switch -u)";
                                    bg-color: Theme.mauve;
                                    text-color: Theme.crust;
                                    hover-color: Theme.pink;
                                    clicked => { DashboardBridge.update_now(); }
                                }

                                ActionBtn {
                                    text: "🔄 Mettre à jour au reboot (nh os boot -u)";
                                    bg-color: Theme.surface1;
                                    text-color: Theme.text;
                                    hover-color: Theme.surface2;
                                    clicked => { DashboardBridge.update_on_boot(); }
                                }
                            }
                        }
                    }
                }

                // Tab 1: DISKS & GENERATIONS
                if DashboardBridge.active_tab == 1: VerticalLayout {
                    spacing: 14px;

                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 12px;

                            HorizontalLayout {
                                alignment: space-between;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text {
                                        text: "NETTOYAGE DU NIX STORE & GÉNÉRATIONS";
                                        color: Theme.sapphire;
                                        font-size: 13px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Espace Nix Store : " + DashboardBridge.store_size + " • " + DashboardBridge.generations_count + " générations archivées";
                                        color: Theme.subtext0;
                                        font-size: 12px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    ActionBtn {
                                        text: "🧹 Nettoyer (Garder 3)";
                                        bg-color: Theme.surface1;
                                        hover-color: Theme.surface2;
                                        clicked => { DashboardBridge.clean_generations(3); }
                                    }
                                    ActionBtn {
                                        text: "🗑️ Nettoyage Complet";
                                        bg-color: Theme.maroon;
                                        text-color: Theme.crust;
                                        hover-color: Theme.red;
                                        clicked => { DashboardBridge.clean_all(); }
                                    }
                                    ActionBtn {
                                        text: "⚙️ Optimiser le Store";
                                        bg-color: Theme.surface1;
                                        hover-color: Theme.surface2;
                                        clicked => { DashboardBridge.optimise_store(); }
                                    }
                                }
                            }
                        }
                    }

                    // Generations List
                    Card {
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            Text {
                                text: "HISTORIQUE DES GÉNÉRATIONS NIXOS DÉPLOYÉES";
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 700;
                            }

                            ScrollView {
                                height: 420px;
                                VerticalLayout {
                                    spacing: 8px;
                                    padding-right: 8px;

                                    for gen in DashboardBridge.generations: Rectangle {
                                        height: 52px;
                                        border-radius: 8px;
                                        background: gen.is_current ? Theme.surface0 : Theme.mantle;
                                        border-width: gen.is_current ? 1px : 0px;
                                        border-color: Theme.green;

                                        HorizontalLayout {
                                            padding-left: 16px;
                                            padding-right: 16px;
                                            spacing: 16px;
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: 12px;
                                                alignment: start;

                                                Rectangle {
                                                    width: 46px;
                                                    height: 26px;
                                                    border-radius: 6px;
                                                    background: gen.is_current ? Theme.green : Theme.surface1;
                                                    y: 13px;

                                                    Text {
                                                        text: "#" + gen.id;
                                                        color: gen.is_current ? Theme.crust : Theme.text;
                                                        font-size: 12px;
                                                        font-weight: 700;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text {
                                                        text: "Déployée le " + gen.date;
                                                        color: Theme.text;
                                                        font-size: 12px;
                                                        font-weight: 600;
                                                    }
                                                    Text {
                                                        text: "Noyau: " + gen.kernel + " • NixOS: " + gen.version;
                                                        color: Theme.subtext0;
                                                        font-size: 11px;
                                                    }
                                                }
                                            }

                                            if gen.is_current: Rectangle {
                                                width: 80px;
                                                height: 24px;
                                                border-radius: 12px;
                                                background: Theme.green;
                                                y: 14px;
                                                Text {
                                                    text: "BOOTED";
                                                    color: Theme.crust;
                                                    font-size: 10px;
                                                    font-weight: 800;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Tab 2: CONFIGURATION & OPTIONAL APPS
                if DashboardBridge.active_tab == 2: VerticalLayout {
                    spacing: 14px;

                    // Header bar
                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: "CONFIGURATION CHOMIAMOS & APPLICATIONS OPTIONNELLES";
                                color: Theme.text;
                                font-size: 14px;
                                font-weight: 700;
                            }
                            Text {
                                text: "Modifie directement /etc/nixos/vars.nix et applique avec nh os switch";
                                color: Theme.subtext0;
                                font-size: 12px;
                            }
                        }

                        ActionBtn {
                            text: "💾 Enregistrer & Appliquer (nh os switch)";
                            bg-color: Theme.green;
                            text-color: Theme.crust;
                            hover-color: Theme.teal;
                            clicked => { DashboardBridge.save_and_apply(); }
                        }
                    }

                    // Grid of 3 columns
                    ScrollView {
                        height: 520px;
                        VerticalLayout {
                            spacing: 14px;
                            padding-right: 8px;

                            HorizontalLayout {
                                spacing: 14px;

                                // Column 1: Gaming
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;

                                        Text {
                                            text: "🎮 ÉCOSYSTÈME GAMING";
                                            color: Theme.mauve;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }

                                        ToggleSwitch {
                                            text: "Steam & Proton-GE";
                                            description: "Client Valve officiel & compatibilité Windows";
                                            checked: DashboardBridge.game_steam;
                                            toggled(val) => { DashboardBridge.game_steam = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Heroic Games Launcher";
                                            description: "Epic Games Store, GOG & Amazon";
                                            checked: DashboardBridge.game_heroic;
                                            toggled(val) => { DashboardBridge.game_heroic = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Lutris";
                                            description: "Jeux PC, standalone & scripts communautaires";
                                            checked: DashboardBridge.game_lutris;
                                            toggled(val) => { DashboardBridge.game_lutris = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Faugus Launcher";
                                            description: "Lanceur rapide optimisé jeux";
                                            checked: DashboardBridge.game_faugus;
                                            toggled(val) => { DashboardBridge.game_faugus = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Decky Loader";
                                            description: "Plugins d'overlay gaming";
                                            checked: DashboardBridge.game_decky;
                                            toggled(val) => { DashboardBridge.game_decky = val; }
                                        }
                                        ToggleSwitch {
                                            text: "GeForce NOW";
                                            description: "Cloud gaming NVIDIA";
                                            checked: DashboardBridge.game_geforce;
                                            toggled(val) => { DashboardBridge.game_geforce = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Volants & Pédaliers";
                                            description: "Pilotes Logitech/Thrustmaster Force Feedback";
                                            checked: DashboardBridge.game_wheels;
                                            toggled(val) => { DashboardBridge.game_wheels = val; }
                                        }
                                    }
                                }

                                // Column 2: Emulation
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;

                                        Text {
                                            text: "🕹️ CENTRE D'ÉMULATION";
                                            color: Theme.blue;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }

                                        ToggleSwitch {
                                            text: "Activer l'Émulation Globale";
                                            description: "Active la suite et le montage ROMs";
                                            checked: DashboardBridge.emu_enable;
                                            toggled(val) => { DashboardBridge.emu_enable = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Frontend ES-DE";
                                            description: "EmulationStation Desktop Edition";
                                            checked: DashboardBridge.emu_enable;
                                            toggled(val) => { }
                                        }
                                        ToggleSwitch {
                                            text: "RetroArch";
                                            description: "Cœurs multi-consoles retro";
                                            checked: DashboardBridge.emu_retroarch;
                                            toggled(val) => { DashboardBridge.emu_retroarch = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Eden (Switch)";
                                            description: "Émulateur Nintendo Switch nouvelle génération";
                                            checked: DashboardBridge.emu_eden;
                                            toggled(val) => { DashboardBridge.emu_eden = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Dolphin (GameCube / Wii)";
                                            checked: DashboardBridge.emu_dolphin;
                                            toggled(val) => { DashboardBridge.emu_dolphin = val; }
                                        }
                                        ToggleSwitch {
                                            text: "PCSX2 (PlayStation 2)";
                                            checked: DashboardBridge.emu_pcsx2;
                                            toggled(val) => { DashboardBridge.emu_pcsx2 = val; }
                                        }
                                        ToggleSwitch {
                                            text: "PPSSPP (PlayStation Portable)";
                                            checked: DashboardBridge.emu_ppsspp;
                                            toggled(val) => { DashboardBridge.emu_ppsspp = val; }
                                        }
                                        ToggleSwitch {
                                            text: "MelonDS (Nintendo DS)";
                                            checked: DashboardBridge.emu_melonds;
                                            toggled(val) => { DashboardBridge.emu_melonds = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Azahar (Nintendo 3DS)";
                                            checked: DashboardBridge.emu_azahar;
                                            toggled(val) => { DashboardBridge.emu_azahar = val; }
                                        }
                                        ToggleSwitch {
                                            text: "mGBA (Game Boy Advance)";
                                            checked: DashboardBridge.emu_mgba;
                                            toggled(val) => { DashboardBridge.emu_mgba = val; }
                                        }
                                        ToggleSwitch {
                                            text: "RPCS3 (PlayStation 3)";
                                            checked: DashboardBridge.emu_rpcs3;
                                            toggled(val) => { DashboardBridge.emu_rpcs3 = val; }
                                        }
                                    }
                                }

                                // Column 3: Multimedia & Pro Tools
                                Card {
                                    VerticalLayout {
                                        padding: 16px;
                                        spacing: 8px;

                                        Text {
                                            text: "🎨 CRÉATION & MULTIMÉDIA";
                                            color: Theme.peach;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }

                                        ToggleSwitch {
                                            text: "OBS Studio";
                                            description: "Streaming & enregistrement avec plugins broadcast";
                                            checked: DashboardBridge.create_obs;
                                            toggled(val) => { DashboardBridge.create_obs = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Blender";
                                            description: "Modélisation & rendu 3D avec ROCm/HIP";
                                            checked: DashboardBridge.create_blender;
                                            toggled(val) => { DashboardBridge.create_blender = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Godot Engine 4";
                                            description: "Moteur de jeux vidéo 2D/3D";
                                            checked: DashboardBridge.create_godot;
                                            toggled(val) => { DashboardBridge.create_godot = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Kdenlive";
                                            description: "Montage vidéo non linéaire";
                                            checked: DashboardBridge.create_kdenlive;
                                            toggled(val) => { DashboardBridge.create_kdenlive = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Antigravity IDE";
                                            description: "Suite de développement et d'assistance IA";
                                            checked: DashboardBridge.create_antigravity;
                                            toggled(val) => { DashboardBridge.create_antigravity = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Pear Desktop";
                                            description: "Gestionnaire de fenêtres & utilitaire ChomiamOS";
                                            checked: DashboardBridge.create_pear;
                                            toggled(val) => { DashboardBridge.create_pear = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Virtualisation KVM / Virt-Manager";
                                            description: "Machines virtuelles accélérées matériellement";
                                            checked: DashboardBridge.create_kvm;
                                            toggled(val) => { DashboardBridge.create_kvm = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Suite IA Locale";
                                            description: "Ollama LLM & interface Web";
                                            checked: DashboardBridge.create_ai;
                                            toggled(val) => { DashboardBridge.create_ai = val; }
                                        }
                                        ToggleSwitch {
                                            text: "Tailscale VPN";
                                            description: "Réseau privé maillé sécurisé";
                                            checked: DashboardBridge.media_tailscale;
                                            toggled(val) => { DashboardBridge.media_tailscale = val; }
                                        }
                                        ToggleSwitch {
                                            text: "LocalSend";
                                            description: "Partage de fichiers P2P réseau local";
                                            checked: DashboardBridge.media_localsend;
                                            toggled(val) => { DashboardBridge.media_localsend = val; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // === MODAL TERMINAL OVERLAY ===
    if DashboardBridge.terminal_open: Rectangle {
        background: #000000bb;

        Card {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 860px;
            height: 540px;
            background: Theme.crust;
            border-color: Theme.surface1;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Terminal Header
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: "💻";
                            font-size: 16px;
                        }
                        Text {
                            text: DashboardBridge.terminal_title;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 100px;
                        height: 24px;
                        border-radius: 12px;
                        background: DashboardBridge.operation_running ? Theme.peach : Theme.green;

                        Text {
                            text: DashboardBridge.operation_running ? "EN COURS..." : "TERMINÉ";
                            color: Theme.crust;
                            font-size: 10px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Terminal Output Area
                Rectangle {
                    background: #0c0c14;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.surface0;

                    ScrollView {
                        VerticalLayout {
                            padding: 12px;
                        TextInput {
                            text: DashboardBridge.terminal_output;
                            color: #a6e3a1;
                            font-size: 11px;
                            font-family: "monospace";
                            read-only: true;
                            single-line: false;
                            wrap: word-wrap;
                        }
                    }
                    }
                }

                // Footer
                HorizontalLayout {
                    alignment: end;
                    ActionBtn {
                        text: "Fermer le Terminal";
                        enabled: !DashboardBridge.operation_running;
                        bg-color: Theme.surface1;
                        hover-color: Theme.surface2;
                        clicked => { DashboardBridge.close_terminal(); }
                    }
                }
            }
        }
    }
}
